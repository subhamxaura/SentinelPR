{
  "name": "sentinelpr",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/lib/web/membership-owner.integration.test.ts src/lib/risk/production-signal.integration.test.ts src/lib/web/rate-limit.redis.integration.test.ts src/lib/retention/retention.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "report": "tsx scripts/generate-report.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "worker:review": "tsx src/workers/review-worker.ts",
    "worker:visual": "tsx src/workers/visual-worker.ts",
    "worker:synthetic": "tsx src/workers/synthetic-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.7.1",
    "dotenv": "^17.3.1",
    "ioredis": "^5.10.0",
    "next": "^16.4.5",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
