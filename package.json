{
  "name": "sentinelpr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/engines",
      "playwright",
      "@prisma/adapter-pg"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "worker:review": "tsx src/workers/review-worker.ts",
    "worker:visual": "tsx src/workers/visual-worker.ts",
    "worker:synthetic": "tsx src/workers/synthetic-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.4",
    "dotenv": "^17.3.1",
    "ioredis": "^5.10.0",
    "next": "^16.3.4",
    "octokit": "^5.0.5",
    "pg": "^8.20.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "17.4.0-beta.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
