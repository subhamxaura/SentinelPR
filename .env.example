# ── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (docker compose provides it on localhost:5432)
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinelpr?schema=public

# Redis for BullMQ queues and job schedulers (docker compose: localhost:6379)
REDIS_URL=redis://localhost:6379

# Public URL of this dashboard — used in GitHub check-run links and artifact URLs
DASHBOARD_URL=http://localhost:3000

# Local single-tenant mode: organization created automatically on first use.
SENTINEL_ORG_SLUG=default
SENTINEL_ORG_NAME=Default Organization

# ── Authentication (multi-user GitHub OAuth) ────────────────────────────
# oauth = GitHub sign-in with server-side sessions; local = single-operator,
# no auth (localhost dev only). Unset = auto: oauth when the client id/secret
# below are set.
SENTINEL_AUTH_MODE=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# HMAC secret for signed OAuth state. Set a strong random value in production.
AUTH_STATE_SECRET=
# 0 = access requires an explicit invite row (no auto-join of the default org).
AUTH_ALLOW_DEFAULT_ORG_SIGNUP=

# ── GitHub App (primary integration) ────────────────────────────────────
# Create at https://github.com/settings/apps — see docs/github-app-setup.md
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key, either raw or base64-encoded (safe for env vars)
GITHUB_APP_PRIVATE_KEY=
# Webhook secret configured on the GitHub App
GITHUB_WEBHOOK_SECRET=

# ── GitHub PAT fallback (manual review runs without the App) ────────────
# Used when a repository is not connected via the App. Needs repo access.
GITHUB_TOKEN=

# ── AI review (optional enhancement — SentinelPR works without it) ──────
# Only provider supported today: openai-compatible
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Suppress AI findings below this confidence (0..1)
AI_CONFIDENCE_THRESHOLD=0.6

# ── Artifact storage ────────────────────────────────────────────────────
# local (dev default, writes to .data/artifacts) | s3 (MinIO/S3/R2)
ARTIFACT_DRIVER=local
ARTIFACT_LOCAL_DIR=.data/artifacts
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sentinelpr
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Secret used to sign artifact URLs. Set a strong random value in production.
ARTIFACT_TOKEN_SECRET=

# ── Security ────────────────────────────────────────────────────────────
# Synthetic/visual targets must be public URLs. Set to 1 ONLY for local dev
# when pointing monitors at localhost services.
SENTINEL_ALLOW_PRIVATE_TARGETS=0

# Optional outgoing webhook for alert fan-out (Slack-compatible JSON POST)
ALERT_WEBHOOK_URL=
