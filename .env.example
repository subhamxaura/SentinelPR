[TEMPLATE]
# ── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (docker compose provides it on localhost:5432)
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinelpr?schema=public

# Redis for BullMQ queues and job schedulers (docker compose: localhost:6379)
REDIS_URL=redis://localhost:6379

# Public URL of this dashboard — used in GitHub check-run links and artifact URLs
DASHBOARD_URL=http://localhost:3000

# Local single-tenant mode: organization created automatically on first use.
SENTINEL_ORG_SLUG=default
SENTINEL_ORG_NAME=Default Organization

# ── Authentication (multi-user GitHub OAuth) ────────────────────────────
# oauth = GitHub sign-in with server-side sessions; local = single-operator,
# no auth (localhost dev only). Unset = auto: oauth when the client id/secret
# below are set.
SENTINEL_AUTH_MODE=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# HMAC secret for signed OAuth state + session binding (AUTH_SECRET also accepted). Set a strong random value in production.
AUTH_STATE_SECRET=
# 0 = access requires an explicit invite row (no auto-join of the default org).
AUTH_ALLOW_DEFAULT_ORG_SIGNUP=

# ── GitHub App (primary integration) ────────────────────────────────────
# Create at https://github.com/settings/apps — see docs/github-app-setup.md
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key, either raw or base64-encoded (safe for env vars)
GITHUB_APP_PRIVATE_KEY=
# Webhook secret configured on the GitHub App
GITHUB_WEBHOOK_SECRET=
# Optional dedicated HMAC secret for installation flow (GITHUB_APP_SETUP_SECRET also accepted; falls back to domain-separated AUTH_STATE_SECRET)
GITHUB_INSTALLATION_SECRET=

# ── GitHub PAT fallback (manual review runs without the App) ────────────
# Used when a repository is not connected via the App. Needs repo access.
GITHUB_TOKEN=

# ── AI review (optional enhancement — SentinelPR works without it) ──────
# Only provider supported today: openai-compatible
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Suppress AI findings below this confidence (0..1)
AI_CONFIDENCE_THRESHOLD=0.6

# ── Artifact storage ────────────────────────────────────────────────────
# local (dev default, writes to .data/artifacts) | s3 (MinIO/S3/R2)
ARTIFACT_DRIVER=local
ARTIFACT_LOCAL_DIR=.data/artifacts
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sentinelpr
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Secret used to sign artifact URLs. Set a strong random value in production.
ARTIFACT_TOKEN_SECRET=

# ── Security ─────────────────────────────────────────────────────────────
# Required in production unless AUTH_STATE_SECRET is set; HMACs opaque Redis keys.
RATE_LIMIT_SECRET=
# Set only to the exact number of rightmost X-Forwarded-For hops controlled by trusted proxies.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Defaults: authenticated reads 120/min, writes 60/min, anonymous API 60/min.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
# Expensive policy window (default 10 minutes); per-user counts per window.
RATE_LIMIT_EXPENSIVE_WINDOW_SECONDS=600
RATE_LIMIT_OAUTH_PER_WINDOW=20
RATE_LIMIT_MANUAL_REVIEW_PER_WINDOW=5
RATE_LIMIT_VISUAL_RUN_PER_WINDOW=5
RATE_LIMIT_SYNTHETIC_RUN_PER_WINDOW=10
RATE_LIMIT_INSTALLATION_PER_WINDOW=10
RATE_LIMIT_ACCESS_REQUEST_PER_WINDOW=3
RATE_LIMIT_ARTIFACT_DOWNLOAD_PER_MINUTE=60
# ── Database and artifact retention (disabled by default) ─────────────────
# Dry run reports eligible counts only. Enable after backup/recovery procedures are tested.
RETENTION_ENABLED=0
RETENTION_DRY_RUN=1
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=100
RETENTION_REVIEW_RUN_DAYS=180
RETENTION_VISUAL_RUN_DAYS=90
RETENTION_SYNTHETIC_RUN_DAYS=90
RETENTION_JOB_RECORD_DAYS=30
RETENTION_WEBHOOK_DELIVERY_DAYS=90
RETENTION_ARTIFACT_DAYS=90
RETENTION_REVIEW_OUTBOX_DAYS=30
# 0 preserves audit history indefinitely.
RETENTION_AUDIT_LOG_DAYS=0
# Synthetic/visual targets must be public URLs. Set to 1 ONLY for local dev
# when pointing monitors at localhost services.
SENTINEL_ALLOW_PRIVATE_TARGETS=0

# Optional outgoing webhook for alert fan-out (Slack-compatible JSON POST)
ALERT_WEBHOOK_URL=

# ── Worker metrics (Prometheus / OpenTelemetry) ─────────────────────────
# Each worker serves Prometheus text exposition at /metrics on this port —
# queue depth, active jobs, job counts and duration histograms. Point an OTel
# Collector (Prometheus receiver) or Grafana Agent at it.
METRICS_PORT=9464
